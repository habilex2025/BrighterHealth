{
  "extends": ["stylelint-config-standard", "stylelint-config-standard-scss", "stylelint-config-prettier"],
  "ignoreFiles": [
    "**/*.js",
    "src/scss/_breakpoints.scss",
    "src/scss/_easing.scss",
    "src/scss/_sprites.scss",
    "src/templates/sprite-template.scss",
    "src/scss/modules/_image-lockup.scss"
  ],
  "rules": {
    "selector-class-pattern": "^[a-z][a-z0-9_-]+",
    "no-invalid-position-at-import-rule": null,
    "declaration-colon-space-after": "always",
    "declaration-block-semicolon-newline-after": "always",
    "at-rule-empty-line-before": null,
    "value-keyword-case": null,
    "no-descending-specificity": null,
    "comment-empty-line-before": null,
    "property-no-vendor-prefix": null,
    "color-function-notation": null,
    "alpha-value-notation": null,
    "scss/dollar-variable-empty-line-before": null,
    "scss/no-global-function-names": null,
    "scss/at-extend-no-missing-placeholder": null,
    "scss/dollar-variable-pattern": [
      "^[a-zA-Z0-9]*$",
      {
        "message": "Expected variable to be camel-case"
      }
    ]
  }
}
